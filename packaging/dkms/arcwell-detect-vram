#!/bin/bash
# arcwell-detect-vram — emit the module options for this machine.
#
# vram_usable cannot be guessed from PCI config: pci_resource_len() is the BAR
# aperture, not memory. xe prints the real figure at probe. This reads it back.
#
# Usage: arcwell-detect-vram <gpu-bdf> [nvme-bdf] [block-device]
#        arcwell-detect-vram 0000:0f:00.0 0000:01:00.0 /dev/nvme0n1
set -u
GPU="${1:?usage: arcwell-detect-vram <gpu-bdf> [nvme-bdf] [bdev]}"
NVME="${2:-}"
BDEV="${3:-}"

# xe prints: "VRAM[0]: Actual physical size 0x..., usable size exclude stolen 0x..., ..."
#
# Try the ring buffer first, then the boot journal. dmesg rotates -- on a machine
# that has been running experiments all day the line is long gone, which is
# exactly when someone reaches for the BAR length instead. Do not make them.
grab() { grep -F "xe $GPU" | grep -o 'usable size exclude stolen 0x[0-9a-f]*' | tail -1 | grep -o '0x[0-9a-f]*'; }
USABLE=$(dmesg 2>/dev/null | grab)
[ -z "$USABLE" ] && USABLE=$(journalctl -k -b 2>/dev/null | grab)
[ -z "$USABLE" ] && USABLE=$(journalctl -k -b -1 2>/dev/null | grab)
if [ -z "$USABLE" ]; then
	echo "arcwell-detect-vram: no 'usable size exclude stolen' line for $GPU in" >&2
	echo "  dmesg or the boot journal. Either the GPU BDF is wrong, or xe did not" >&2
	echo "  probe this device, or the journal is not persistent." >&2
	echo "  Check: journalctl -k -b | grep -F 'xe $GPU'" >&2
	echo "  Do NOT substitute the BAR length: it is larger than VRAM, and carving" >&2
	echo "  by BAR length registers DMA pages over memory that is not there." >&2
	exit 1
fi

# Auto-detect the NVMe controller if not given: first class 0x010802 device.
if [ -z "$NVME" ]; then
	NVME=$(lspci -D -n 2>/dev/null | awk '$2=="0108:" {print $1; exit}')
	[ -z "$NVME" ] && NVME=$(lspci -D -nn 2>/dev/null | grep -m1 -i 'non-volatile memory' | cut -d' ' -f1)
fi
[ -z "$BDEV" ] && BDEV=/dev/nvme0n1

echo "# $(date -Is) generated by arcwell-detect-vram"
echo "options arcwell arc_bdf=$GPU nvme_bdf=${NVME:-UNSET} bdev_path=$BDEV vram_usable=$USABLE"
[ -z "${NVME:-}" ] && { echo "arcwell-detect-vram: could not detect the NVMe BDF; pass it explicitly." >&2; exit 1; }
exit 0
