# Generated by arcwell-detect-vram. Do not edit by hand; re-run the detector
# after a GPU change, a BIOS change, or an xe update.
#
# vram_usable MUST match xe's own "usable size exclude stolen" figure. The PCI BAR
# is larger than usable VRAM -- on the development hardware a 32 GiB BAR fronts
# 24 GiB of memory, and both cards reserve stolen memory at the top. Carving by
# BAR length registers DMA-able pages over memory that is not there.
options arcwell arc_bdf=@ARC_BDF@ nvme_bdf=@NVME_BDF@ bdev_path=@BDEV@ vram_usable=@VRAM_USABLE@
